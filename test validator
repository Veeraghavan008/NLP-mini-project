def main():
    data = pd.read_csv(os.path.join(BASE, "complaints_dataset.csv"))
    v = ComplaintValidator(data["complaint"], os.path.join(BASE, "invalid_examples.csv"))
    fr = [t for t in VALID_TEST if not v.validate(t)[0]]
    fa = [t for t in INVALID_TEST if v.validate(t)[0]]
    print(f"Genuine complaints wrongly rejected: {len(fr)}/{len(VALID_TEST)}")
    for t in fr: print("   REJECTED:", t, "->", v.validate(t)[1][:70], f"(p={v.p_valid(t):.2f})")
    print(f"Invalid entries wrongly accepted:    {len(fa)}/{len(INVALID_TEST)}")
    for t in fa: print("   ACCEPTED:", t, f"(p={v.p_valid(t):.2f})")
    ok = len(VALID_TEST) - len(fr) + len(INVALID_TEST) - len(fa)
    print(f"Overall: {ok}/{len(VALID_TEST)+len(INVALID_TEST)} correct")
    return 0

if __name__ == "__main__":
    sys.exit(main())
